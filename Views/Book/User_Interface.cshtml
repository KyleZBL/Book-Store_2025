@{
    ViewBag.Title = "User Interface";
}

@using Book_Store.Models
@model IEnumerable<Book>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Interface</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body class="container">

    <h1>Book Store</h1>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">Book Store</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/Book/User_Interface">Main</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Account/Login">Login</a>
                </li>
            </ul>
        </div>
    </nav>


    <!-- Search by Author ID -->
    <form method="get" action="@Url.Action("Index", "Books")">
        <div class="form-group">
            <label for="authorId">Enter Author ID:</label>
            <input type="number" class="form-control" id="authorId" name="authorId" required>
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <br>

    <!-- Display Book List -->
    @if (Model != null && Model.Any())
    {
        <h2>Book Inventory</h2>
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Book ID</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Pages</th>
                    <th>Publishing Date</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.BookID</td>
                        <td>@book.Title</td>

                        <td>@book.Genre</td>
                        <td>@book.Price</td>
                        <td>@book.Stock</td>
                        <td>@book.Pages</td>
                        <td>@book.PublishingDate.ToShortDateString()</td>
                        <td>@book.AuthorName</td>

                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No books found.</p>
    }

</body>
</html>