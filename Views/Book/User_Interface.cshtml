@{
    ViewBag.Title = "User Interface";
}

@using Book_Store.Models
@model IEnumerable<Book>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Interface</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body class="container pt-2">

    <h1 class=" text-center d-none">Book Store</h1>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">Book Store</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse text" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/Book/User_Interface">Main</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Account/Login">Login</a>
                </li>
            </ul>
        </div>
    </nav>
    <br>

    <!-- Forms -->
    <form method="get" action="@Url.Action("SearchByAuthor", "Book")">
        <label class="font-weight-bold" for="authorName">Author:</label>
        <input type="text" name="authorName" placeholder="Author first & last name" required class="form-control-sm">
        <br>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <br>
    <form method="get" action="@Url.Action("SearchByGenre", "Book")">
        <label class="font-weight-bold" for="genre">Genre:</label>
        <input type="text" name="genre" placeholder="Enter genre" required class="form-control-sm ml-2">
        <br>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Search Result/Book Inventory -->
    @if (Model != null && Model.Any())
    {
        <h2 class="text-center">Book Inventory</h2>
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Book ID</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Pages</th>
                    <th>Publishing Date</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.BookID</td>
                        <td>@book.Title</td>

                        <td>@book.Genre</td>
                        <td>@book.Price</td>
                        <td>@book.Stock</td>
                        <td>@book.Pages</td>
                        <td>@book.PublishingDate.ToShortDateString()</td>
                        <td>@book.AuthorName</td>

                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No books found.</p>
    }
</body>
</html>