@{
    ViewBag.Title = "Update";
}

@using Book_Store.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Book</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>

    <!-- Display Book List -->
    <div class="container mt-4">
        <h2 class="text-center mb-4">Edit Book</h2>
        <table class="table table-bordered table-striped">
            <tr><th>Book ID:</th><td>@Model.BookID</td></tr>
            <tr><th>Title:</th><td>@Model.Title</td></tr>
            <tr><th>Genre:</th><td>@Model.Genre</td></tr>
            <tr><th>Price:</th><td>@Model.Price.ToString("F2")</td></tr>
            <tr><th>Stock:</th><td>@Model.Stock</td></tr>
            <tr><th>Pages:</th><td>@Model.Pages</td></tr>
            <tr><th>Publishing Date:</th><td>@Model.PublishingDate.ToString("yyyy-MM-dd")</td></tr>
            <tr><th>Author:</th><td>@Model.Author.FirstName @Model.Author.LastName</td></tr>
        </table>

        <hr>

        <form action="@Url.Action("Update", "Book")" method="post" class="p-4 border rounded shadow">
            <input type="hidden" name="BookID" value="@Model.BookID" />

            <div class="mb-3">
                <label for="Title" class="form-label">Title:</label>
                <input type="text" class="form-control" name="Title" id="Title" value="@Model.Title" required>
            </div>

            <div class="mb-3">
                <label for="Genre" class="form-label">Genre:</label>
                <input type="text" class="form-control" name="Genre" id="Genre" value="@Model.Genre" required>
            </div>

            <div class="mb-3">
                <label for="Price" class="form-label">Price:</label>
                <input type="number" class="form-control" name="Price" id="Price" value="@Model.Price" required>
            </div>

            <div class="mb-3">
                <label for="Stock" class="form-label">Stock:</label>
                <input type="number" class="form-control" name="Stock" id="Stock" value="@Model.Stock" required>
            </div>

            <div class="mb-3">
                <label for="Pages" class="form-label">Pages:</label>
                <input type="number" class="form-control" name="Pages" id="Pages" value="@Model.Pages" required>
            </div>

            <div class="mb-3">
                <label for="PublishingDate" class="form-label">Publishing Date:</label>
                <input type="date" class="form-control" name="PublishingDate" id="PublishingDate" value="@Model.PublishingDate.ToString("yyyy-MM-dd")" required>
            </div>

            <!-- Author Details -->
            <input type="hidden" name="AuthorID" value="@Model.AuthorID" />

            <div class="mb-3">
                <label for="AuthorFirstName" class="form-label">Author First Name:</label>
                <input type="text" class="form-control" name="Author.FirstName" id="AuthorFirstName" value="@Model.Author.FirstName" required>
            </div>

            <div class="mb-3">
                <label for="AuthorLastName" class="form-label">Author Last Name:</label>
                <input type="text" class="form-control" name="Author.LastName" id="AuthorLastName" value="@Model.Author.LastName" required>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success">Save Changes</button>
                <a href="/Book/Administrator" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>