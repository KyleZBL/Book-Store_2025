@{
    ViewBag.Title = "Administrator Interface";
}

@using Book_Store.Models
@model IEnumerable<Book>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrator View</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body class="container">

    <h1>Administrator Dashboard</h1>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">Book Store</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/Book/User_Interface">Main</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Account/Login">Login</a>
                </li>
            </ul>
        </div>
    </nav>

    <br>

    <!-- Book Inventory & Management -->
    <h2>Book Inventory</h2>

    <!-- CRUD Actions -->
    <div class="mb-3">
        <a href="/Book/Create" class="btn btn-success">Create New Book</a>
        <a href="/Author/Create" class="btn btn-primary">Create New Author</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Book ID</th>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Pages</th>
                    <th>Publishing Date</th>
                    <th>Author</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.BookID</td>
                        <td>@book.Title</td>
                        <td>@book.Genre</td>
                        <td>@book.Price</td>
                        <td>@book.Stock</td>
                        <td>@book.Pages</td>
                        <td>@book.PublishingDate.ToShortDateString()</td>
                        <td>@book.AuthorName</td>
                        <td>
                            <a href="/Book/Edit/@book.BookID" class="btn btn-warning btn-sm">Edit</a>
                            <form method="post" action="/Book/Delete" onsubmit="return confirm('Are you sure you want to delete this book?');">
                                <input type="hidden" name="book_Id" value="@book.BookID" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No books found.</p>
    }

</body>
</html>